            "imagePullPolicy": "Always",
            "name": "bootstrap",
            "resources": {
              "limits": {
                "cpu": "1",
                "ephemeral-storage": "256Mi",
                "memory": "512Mi"
              },
              "requests": {
                "cpu": "1",
                "ephemeral-storage": "256Mi",
                "memory": "512Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": false,
              "runAsGroup": 0,
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
