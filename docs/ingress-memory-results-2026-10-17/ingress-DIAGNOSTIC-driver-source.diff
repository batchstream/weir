+// These host-only observations include fixture construction and public SDK work.
+// ReadMemStats and profiling perturb timing; they do not measure the Linux CLI.
+func ingressMemoryDiagnosticRuntime(t *testing.T, phase string) {
+	t.Helper()
+	var heap runtime.MemStats
+	runtime.ReadMemStats(&heap)
+	names := []string{"/cpu/classes/total:cpu-seconds", "/cpu/classes/user:cpu-seconds", "/cpu/classes/gc/total:cpu-seconds", "/cpu/classes/gc/mark/assist:cpu-seconds", "/gc/cycles/total:gc-cycles", "/gc/heap/goal:bytes", "/gc/gomemlimit:bytes"}
+	samples := make([]runtimemetrics.Sample, len(names))
+	for index, name := range names {
+		samples[index].Name = name
+	}
+	runtimemetrics.Read(samples)
+	values := make(map[string]any, len(samples))
+	for _, sample := range samples {
+		switch sample.Value.Kind() {
+		case runtimemetrics.KindUint64:
+			values[sample.Name] = sample.Value.Uint64()
+		case runtimemetrics.KindFloat64:
+			values[sample.Name] = sample.Value.Float64()
+		default:
+			values[sample.Name] = "unavailable"
+		}
+	}
+	encoded, err := json.Marshal(values)
+	t.Logf("DIAGNOSTIC host_runtime phase=%s at=%s GOMAXPROCS=%d NumCPU=%d NumGoroutine=%d HeapAlloc=%d TotalAlloc=%d Sys=%d NumGC=%d PauseTotalNs=%d runtime_metrics=%s metrics_error=%v CPU_metrics_are_Go_runtime_estimates_not_OS_process_CPU=true", phase, time.Now().UTC().Format(time.RFC3339Nano), runtime.GOMAXPROCS(0), runtime.NumCPU(), runtime.NumGoroutine(), heap.HeapAlloc, heap.TotalAlloc, heap.Sys, heap.NumGC, heap.PauseTotalNs, encoded, err)
+}
